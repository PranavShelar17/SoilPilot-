# Environment Configuration
# Copy this file to .env and update values

# ============================================
# Application
# ============================================
APP_ENV=development
PUBLIC_APP_URL=http://localhost:5173
DEMO_MODE=true

# ============================================
# Database (PostgreSQL + PostGIS)
# ============================================
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/dsm_soil_health
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=dsm_soil_health
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# ============================================
# Authentication
# ============================================
JWT_SECRET=change-this-to-a-secure-random-string-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRY_HOURS=24

# ============================================
# OTP Configuration
# ============================================
OTP_PROVIDER=mock
OTP_EXPIRY_SECONDS=300
OTP_MAX_ATTEMPTS=3
OTP_COOLDOWN_SECONDS=60

# ============================================
# Map Configuration (configurable basemap)
# ============================================
VITE_API_URL=http://localhost:8000
VITE_MAP_STREETS_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
VITE_MAP_STREETS_ATTRIBUTION=© OpenStreetMap contributors
VITE_MAP_SATELLITE_URL=https://server.arcgisonline.com/ArcGIS/rest/services/World_Imagery/MapServer/tile/{z}/{y}/{x}
VITE_MAP_SATELLITE_ATTRIBUTION=© Esri

# ============================================
# Storage
# ============================================
STORAGE_PATH=./storage
REPORTS_PATH=./storage/reports

# ============================================
# CORS
# ============================================
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
