# ============================================
# DSM Soil Health Portal — .gitignore
# ============================================

# Environment
.env
.env.local
.env.*.local

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg-info/
dist/
build/
*.egg
.eggs/
venv/
.venv/
env/

# Node
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Vite
frontend/dist/

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db
Desktop.ini

# Docker
docker/data/

# Storage (generated files)
storage/
*.pdf

# Database
*.sql.bak

# Data — do not commit production/incoming data
data/incoming/

# Logs
*.log
logs/

# Coverage
.coverage
htmlcov/
.pytest_cache/

# Alembic
alembic/versions/__pycache__/

# Temporary
tmp/
temp/
